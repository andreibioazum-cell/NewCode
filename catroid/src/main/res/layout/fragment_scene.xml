<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scene_background">

    <org.catrobat.catroid.ui.scene.SceneView
        android:id="@+id/scene_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/scene_name_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@color/scene_label_background"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textColor="@color/solid_white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/scene_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/scene_label_background"
        android:padding="12dp"
        android:text="@string/scene_hint"
        android:textColor="@color/solid_white"
        android:textSize="14sp" />

</FrameLayout>
