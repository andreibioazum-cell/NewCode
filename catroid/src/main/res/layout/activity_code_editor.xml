<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/toolbar" />

    <EditText
        android:id="@+id/code_editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/code_editor_background"
        android:gravity="top|start"
        android:hint="@string/code_editor_hint"
        android:inputType="textMultiLine|textNoSuggestions"
        android:lineSpacingExtra="2dp"
        android:padding="12dp"
        android:scrollbars="vertical"
        android:textColor="@color/code_editor_text"
        android:textColorHint="#4B5568"
        android:textSize="14sp"
        android:typeface="monospace" />

    <TextView
        android:id="@+id/code_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/code_status_background"
        android:padding="6dp"
        android:text="@string/code_saved"
        android:textColor="@color/code_status_text"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
